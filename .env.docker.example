# =============================================================================
# Variables para el stack docker de wacrm (copiar a .env y rellenar).
# En Coolify estos valores se configuran como "Environment Variables".
# NUNCA commitear el .env real.
# =============================================================================

# --- Postgres ----------------------------------------------------------------
POSTGRES_DB=postgres
POSTGRES_PASSWORD=<password aleatorio>

# --- Supabase interno ----------------------------------------------------------
# Secreto con el que se firman/verifican los JWT (gotrue, postgrest, realtime,
# storage y la app). ANON_KEY / SERVICE_ROLE_KEY son JWT firmados con él.
JWT_SECRET=<secreto aleatorio>
ANON_KEY=<jwt role=anon firmado con JWT_SECRET>
SERVICE_ROLE_KEY=<jwt role=service_role firmado con JWT_SECRET>
SECRET_KEY_BASE=<secreto aleatorio 48+ chars>
REALTIME_DB_ENC_KEY=<hex de 32 caracteres = exactamente 16 bytes>
PG_META_CRYPTO_KEY=<base64 de 32 bytes>
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=<password aleatorio>

# --- URLs públicas -------------------------------------------------------------
# Kong (auth + rest + realtime + storage + studio) y la app.
API_EXTERNAL_URL=https://supabase-wacrm.varillas.work
SITE_URL=https://wacrm.varillas.work

# --- SMTP (mailpit local por defecto) ------------------------------------------
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=no-reply@varillas.work
SMTP_SENDER_NAME=wacrm

# --- Storage (backend local en disco) -------------------------------------------
GLOBAL_S3_BUCKET=stub
STORAGE_TENANT_ID=stub
REGION=local

# --- App (wacrm) ----------------------------------------------------------------
# Cifrado de tokens de WhatsApp (64 caracteres hex = 32 bytes, AES-256-GCM).
ENCRYPTION_KEY=<64 caracteres hex>

# Meta / WhatsApp (pendiente si aún no hay app de Meta: el webhook rechaza
# peticiones sin secreto válido, pero la app funciona igual).
META_APP_SECRET=<meta app secret>
META_APP_ID=<meta app id>
NEXT_PUBLIC_META_APP_ID=<mismo valor que META_APP_ID>
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=<configuration id de Embedded Signup>

# Cron: /api/cron/check-trials (Bearer CRON_SECRET) y
# /api/automations/cron + /api/flows/cron (AUTOMATION_CRON_SECRET).
CRON_SECRET=<secreto aleatorio>
AUTOMATION_CRON_SECRET=<secreto aleatorio>

# URL pública canónica (sitemap, OG, enlaces de invitación).
NEXT_PUBLIC_SITE_URL=https://wacrm.varillas.work
NEXT_PUBLIC_APP_LOCALE=es
MAINTENANCE_MODE=false
